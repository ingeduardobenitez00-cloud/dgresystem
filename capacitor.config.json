{
  "appId": "py.gov.dgrec.sistema",
  "appName": "DD-DGRE-REC",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://dgre-tsje.web.app",
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#000000"
    }
  }
}
